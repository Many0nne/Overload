# Secrets des Edge Functions (local : copier en supabase/functions/.env ; prod : supabase secrets set).
# Générer une paire avec : npx tsx scripts/gen-vapid.ts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Doit correspondre à private.config.push_secret (local : dev-push-secret)
PUSH_SECRET=dev-push-secret
