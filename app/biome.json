{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "*.ts",
      "*.json",
      "!**/dist",
      "!**/dev-dist",
      "!src/data/catalog.generated.json",
      "!src/data/bodyMap.generated.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "noAutofocus": "off",
        "useButtonType": "off",
        "noLabelWithoutControl": "off"
      },
      "style": { "noNonNullAssertion": "off", "noDescendingSpecificity": "off" },
      "suspicious": { "noArrayIndexKey": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
